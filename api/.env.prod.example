# ---------------------------------------------------------------------------
# Modèle des variables de PROD (Plume). Copier en .env.local sur le serveur
# (gitignoré) et remplir. NE JAMAIS committer de vraie valeur. cf. docs/ops/deployment-checklist.md
# ---------------------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0

# Domaine de prod (HTTPS). Sert au TLS Caddy ET aux URLs applicatives.
SERVER_NAME=plume.exemple.fr
DEFAULT_URI=https://plume.exemple.fr
APP_FRONTEND_URL=https://plume.exemple.fr
CORS_ALLOW_ORIGIN=^https://plume\.exemple\.fr$
# IP/réseau du proxy same-origin devant l'API (loopback si tout sur le même hôte).
TRUSTED_PROXIES=127.0.0.1,::1

# --- Secrets (générer, ne pas réutiliser le dev) ---
# php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=__A_GENERER__
# mot de passe fort ; régénérer les clés JWT avec (lexik:jwt:generate-keypair)
JWT_PASSPHRASE=__A_GENERER__
# php -r "echo base64_encode(random_bytes(32));"
MAILBOX_ENCRYPTION_KEY=__A_GENERER__
TOTP_ENCRYPTION_KEY=__A_GENERER__

# --- Base de données : 2 rôles (ADR-0023) ---
# Propriétaire `plume` (migrations/console/scheduler) :
DATABASE_URL=postgresql://plume:__MDP_OWNER__@database:5432/plume?serverVersion=17&charset=utf8
ADMIN_DATABASE_URL=postgresql://plume:__MDP_OWNER__@database:5432/plume?serverVersion=17&charset=utf8
# Runtime `plume_app` (RLS active — API + workers) :
APP_DB_PASSWORD=__MDP_APP__
APP_DATABASE_URL=postgresql://plume_app:__MDP_APP__@database:5432/plume?serverVersion=17&charset=utf8
# Mot de passe du superuser Postgres du conteneur (= owner `plume`) :
POSTGRES_PASSWORD=__MDP_OWNER__

MESSENGER_TRANSPORT_DSN=doctrine://default

# --- Emails système (obligatoire en prod, sinon aucun envoi) ---
MAILER_DSN=smtp://__UTILISATEUR__:__MDP__@smtp.exemple.fr:587
MAIL_FROM=no-reply@plume.exemple.fr

# --- OAuth mail réel (P2 — quand les apps Google/Microsoft sont prêtes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://plume.exemple.fr/oauth/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://plume.exemple.fr/oauth/outlook/callback

# --- Garde-fou coût IA (ADR-0032) ---
# Sans clé Anthropic : générateur gratuit uniquement (aucune facture).
ANTHROPIC_API_KEY=
AI_GENERATION_ENABLED=1
# Plafond mensuel de jetons (0 = illimité). À FIXER (ex. 2000000) avant d'ouvrir au public.
AI_MONTHLY_TOKEN_BUDGET=0

# --- Abonnement Stripe (ADR-0033 — vide = passerelle factice, pas de paiement réel) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
BILLING_MONTHLY_AMOUNT_EUR=12

# --- Observabilité (ADR-0030 — vide = désactivé) ---
SENTRY_DSN=
