# Valeurs par défaut (dev). Surcharger dans .env.local (non versionné).
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
APP_SHARE_DIR=var/share
# IP/réseau du proxy same-origin (Nitro/Caddy) devant l'API — requis pour un getClientIp()
# correct (rate-limiting par IP). Défaut : loopback (proxy sur le même hôte). À élargir en prod
# si le proxy est sur un autre hôte/réseau (ex. "10.0.0.0/8").
TRUSTED_PROXIES=127.0.0.1,::1
###< symfony/framework-bundle ###

###> symfony/routing ###
# Génération d'URL hors contexte HTTP (commandes CLI).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Hôte "database" = service Docker Compose (cf. compose.yaml à la racine).
# DATABASE_URL = rôle PROPRIÉTAIRE `plume` : migrations, tests, console — CONTOURNE la RLS.
DATABASE_URL="postgresql://plume:plume@database:5432/plume?serverVersion=17&charset=utf8"
# Rôle applicatif RUNTIME `plume_app` (non-propriétaire) : l'API HTTP + le worker s'y connectent
# et sont SOUMIS à la RLS (filet de sécurité multi-tenant en base). Créé par
# `make provision-app-role`. Identifiants dev non secrets (comme plume:plume) ; à surcharger en prod.
APP_DB_USER=plume_app
APP_DB_PASSWORD=plume_app
APP_DATABASE_URL="postgresql://plume_app:plume_app@database:5432/plume?serverVersion=17&charset=utf8"
# Connexion du BACK-OFFICE (contexte Admin) : rôle PROPRIÉTAIRE (lectures cross-tenant légitimes,
# contourne la RLS — ADR-0023, même catégorie que le scheduler). Réservée aux services Admin
# derrière ROLE_ADMIN. À surcharger en prod (mot de passe fort du rôle plume).
ADMIN_DATABASE_URL="postgresql://plume:plume@database:5432/plume?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> cache / rate-limiter store (V2.0-c — hébergement agnostique) ###
# Store du cache applicatif ET des rate-limiters. Défaut : filesystem (mono-hôte).
# Déploiement MULTI-INSTANCES : surcharger le paramètre `app.cache_adapter` en `cache.adapter.redis`
# (config prod) ET pointer REDIS_DSN sur l'instance Redis → les compteurs de rate-limiting sont
# PARTAGÉS (sinon la limite est multipliée par le nombre d'instances). REDIS_DSN est inerte tant que
# l'adapter reste filesystem. Cf. docs/ops/deployment-checklist.md.
REDIS_DSN=redis://localhost
###< cache / rate-limiter store ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_env_local
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> drafting (M1.4 — rédaction assistée) ###
# Clé absente => générateur local déterministe (canned), coût zéro (dev/CI/E2E).
ANTHROPIC_API_KEY=
DRAFTING_MODEL=claude-sonnet-5
# Garde-fou de coût (au-delà du plafond par tenant/heure et du défaut gratuit) :
#   AI_GENERATION_ENABLED=0        → COUPE-CIRCUIT : plus aucun appel payant (repli canned gratuit).
#   AI_MONTHLY_TOKEN_BUDGET=2000000 → PLAFOND mensuel de jetons (entrée+sortie) ; 0 = illimité.
# Atteint le plafond → repli automatique sur le générateur gratuit, sans échec ni facture surprise.
AI_GENERATION_ENABLED=1
AI_MONTHLY_TOKEN_BUDGET=0
###< drafting ###

###> billing (V2.2 — abonnement Stripe) ###
# Sans STRIPE_SECRET_KEY : passerelle FACTICE (dev/CI/E2E ; le checkout active l'abonnement en local).
# En prod : clés Stripe + IDs de prix (mensuel/annuel) créés dans le tableau de bord Stripe,
# et le secret de signature du webhook (endpoint /api/v1/billing/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
###< billing ###

###> mailbox (M2 — passerelle email) ###
# Sans GOOGLE_CLIENT_ID : connecteur factice (dev/CI/E2E, aucun compte réel).
# En prod : identifiants OAuth Google + clé de chiffrement DÉDIÉE (ADR-0016) :
#   MAILBOX_ENCRYPTION_KEY=$(php -r "echo base64_encode(random_bytes(32));")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/outlook/callback
# Callback des connecteurs FACTICES (dev/CI/E2E) — route dynamique front /oauth/[provider]/callback.
MAILBOX_FAKE_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback
MAILBOX_ENCRYPTION_KEY=
###< mailbox ###

###> account (2FA — chiffrement du secret TOTP au repos, ADR-0027) ###
# Vide en dev/CI/E2E : clé dérivée d'APP_SECRET. En prod, clé DÉDIÉE OBLIGATOIRE (fail-fast au boot) :
#   TOTP_ENCRYPTION_KEY=$(php -r "echo base64_encode(random_bytes(32));")
TOTP_ENCRYPTION_KEY=
###< account ###

###> symfony/mailer ###
# Emails SYSTÈME (transactionnels). `null://null` = aucun envoi (dev/CI) ; en prod, un vrai
# transport (SMTP/API) — une ligne, indépendant du choix d'hébergeur (cf. deployment-checklist).
MAILER_DSN=null://null
# Expéditeur des emails système + URL du front (pour bâtir les liens de réinitialisation, etc.).
MAIL_FROM=noreply@plume.local
APP_FRONTEND_URL=http://localhost:3000
###< symfony/mailer ###

###> sentry/sentry-symfony ###
# Error-tracking (prod-only). VIDE = désactivé (dev/CI/test n'envoient jamais rien). En prod,
# renseigner le DSN d'un projet Sentry (SaaS ou self-hosted) pour activer la capture.
SENTRY_DSN=
###< sentry/sentry-symfony ###
